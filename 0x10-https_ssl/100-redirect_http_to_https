frontend lb-01
    bind *:80 transparent
    bind *:443 ssl crt /home/ubuntu/haproxy.pem
    http-request redirect scheme https code 301 unless { ssl_fc }
    mode http
    default_backend webservers

backend webservers
    mode http
    balance roundrobin
    server 377545-web-01 54.196.38.65:80
    server 377545-web-02 18.234.192.180:80
